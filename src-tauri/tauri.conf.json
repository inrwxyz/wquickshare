{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WQuickShare",
  "version": "0.1.0",
  "identifier": "com.inex.wquickshare",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WQuickShare // Quick Share for Windows",
        "url": "index.html",
        "width": 940,
        "height": 680,
        "minWidth": 800,
        "minHeight": 580,
        "center": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright © 2026 Inex. All rights reserved.",
    "category": "Utility",
    "shortDescription": "WQuickShare - Native Quick Share for Windows",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
